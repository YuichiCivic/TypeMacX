<?xml version="1.0" encoding="utf-8"?>
<!-- TypeMacX のインストーラーの画面と中身 (tools/release/make-free-release.sh が @VERSION@ を置き換える) -->
<installer-gui-script minSpecVersion="2">
    <title>TypeMacX</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="LICENSE.txt"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64"/>
    <domains enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="TypeMacX">
        <pkg-ref id="jp.co.aibos.pkg.TypeMacX"/>
    </choice>
    <pkg-ref id="jp.co.aibos.pkg.TypeMacX" version="@VERSION@" onConclusion="none">TypeMacX-component.pkg</pkg-ref>
</installer-gui-script>
